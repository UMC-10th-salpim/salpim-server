DB_URL=jdbc:mysql://localhost:3306/local_db_name?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
DB_USERNAME=local_username
DB_PASSWORD=local_password

# Kakao
GEOCODING_BASE_URL=https://dapi.kakao.com
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/callback
KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me

# JWT (generate a unique value per environment, e.g. `openssl rand -base64 48`)
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_BASE64_SECRET
JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=3600000
JWT_REFRESH_TOKEN_EXPIRATION_MILLIS=1209600000
JWT_SIGNUP_TOKEN_EXPIRATION_MILLIS=600000

# Discord (development only)
DISCORD_OTP_WEBHOOK_URL=

# Bokjiro public data API
BOKJIRO_SERVICE_KEY=your_bokjiro_service_key
LOCAL_BOKJIRO_SERVICE_KEY=your_local_bokjiro_service_key
